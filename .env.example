# Portfolio server — copy this file to .env and fill in the values

# Required: a long random string used to sign session cookies
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional: port (default 3000)
# PORT=3000

# Optional: session duration in days (default 7)
# SESSION_DAYS=7

# Optional: set to 'production' to add Secure flag to cookies (HTTPS only)
# NODE_ENV=production
